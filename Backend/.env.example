# Backend — NBN Express Plus
#
# Copier ce fichier vers `.env.development.local` (ou `.env.production.local`)
# et renseigner les valeurs réelles. Ces fichiers `*.local` sont ignorés par
# git : aucun secret ne doit jamais être committé (CLAUDE.md §3 point 6).

NODE_ENV=development
PORT=5500

# --- Base de données -------------------------------------------------------
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=nbn

# --- Jetons & sessions -----------------------------------------------------
# JWT_SECRET doit être une chaîne aléatoire longue, propre à chaque
# environnement. Ne jamais réutiliser celui de développement en production.
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES_IN=1d
# Durée d'une connexion sans renouvellement. Le site et l'application la
# prolongent silencieusement tant que le refresh token est valide.
ACCESS_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_WEB_DAYS=7
REFRESH_TOKEN_EXPIRES_MOBILE_DAYS=30

# --- URLs & inter-communication --------------------------------------------
# HOST_URL  : adresse publique de cette API (liens des e-mails).
# FRONT_URL : adresse du dashboard web (liens de retour dans les e-mails).
HOST_URL=http://localhost:5500
FRONT_URL=http://localhost:3000
URL_ORIGIN=*

# Origines autorisées par CORS en production, séparées par des virgules.
# Laisser vide pour utiliser la liste par défaut définie dans `app.js` :
#   https://nbnexpress.org, https://www.nbnexpress.org,
#   https://api.nbnexpress.org, https://nbn-plus.vercel.app
# En développement, tout localhost/127.0.0.1 et toute IP LAN privée
# (192.168.x.x, 10.x.x.x, 172.16-31.x.x) est accepté automatiquement.
CORS_ORIGINS=

# Nombre de reverse proxies devant l'API. Vide = 1 en production (le proxy
# du cPanel), aucun en développement. Sans ce réglage, tous les appareils
# partagent l'IP du proxy, donc le même quota de tentatives de connexion.
TRUST_PROXY=

# Production :
#   HOST_URL=https://api.nbnexpress.org
#   FRONT_URL=https://nbnexpress.org
#   CORS_ORIGINS=https://nbnexpress.org,https://www.nbnexpress.org,https://nbn-plus.vercel.app

# --- E-mail (SMTP Gmail) ---------------------------------------------------
# EMAIL_PASSWORD attend un mot de passe d'application Google, jamais le mot
# de passe du compte.
EMAIL=
EMAIL_PASSWORD=

# Délais SMTP en millisecondes. Un serveur mail injoignable échoue vite au
# lieu de retenir la requête HTTP qui l'a déclenché.
SMTP_CONNECTION_TIMEOUT_MS=8000
SMTP_GREETING_TIMEOUT_MS=8000
SMTP_SOCKET_TIMEOUT_MS=10000

# --- Comptes ---------------------------------------------------------------
# Mot de passe attribué aux comptes créés depuis le back-office, envoyé par
# e-mail à l'utilisateur qui doit le changer à la première connexion.
DEFAULT_PASSWD=Changemoi@NBN2026

# E-mail de l'administrateur créé par le seeder par défaut.
SEED_ADMIN_EMAIL=admin@nyumbaniexpress.com

# --- Uploads ---------------------------------------------------------------
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=50

# Pièces d'identité annexées aux bailleurs : dossier PRIVÉ, jamais sous
# `uploads/` (servi publiquement). Chemin relatif au dossier du Backend.
# À inclure dans les sauvegardes du serveur.
IDENTITY_DOCUMENTS_DIR=private/identity-documents
MAX_ID_DOCUMENT_SIZE_MB=8

# --- Formulaires publics ---------------------------------------------------
# Délai de la vérification DNS (MX) des adresses e-mail saisies. Au-delà,
# l'adresse est acceptée : un DNS lent ne doit jamais bloquer un client.
EMAIL_MX_CHECK_TIMEOUT_MS=3000
